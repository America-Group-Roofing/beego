---
const links=[
  {href:"/",label:"Inicio"},
  {href:"/como-funciona/",label:"Cómo funciona"},
  {href:"/bateria-beego/",label:"Conoce BeeGo"},
  {href:"/estaciones/",label:"Estaciones"},
  {href:"/negocios/",label:"Para negocios"},
  {href:"/ayuda/",label:"Ayuda"}
];
const active=(href:string)=>Astro.url.pathname===href||Astro.url.pathname===href.slice(0,-1);
---
<header class="site-header">
  <div class="container nav-shell">
    <a class="brand-logo" href="/" aria-label="BeeGo, ir al inicio">
      <img src="/assets/beego-logo-oficial.png" width="473" height="380" alt="BeeGo" decoding="async"/>
    </a>
    <nav class="primary-nav" aria-label="Navegación principal">
      {links.slice(1).map(l=><a href={l.href} aria-current={active(l.href)?"page":undefined}>{l.label}</a>)}
    </nav>
    <details class="mobile-menu">
      <summary>Menú <span aria-hidden="true">☰</span></summary>
      <nav aria-label="Navegación móvil">
        {links.map(l=><a href={l.href} aria-current={active(l.href)?"page":undefined}>{l.label}</a>)}
      </nav>
    </details>
  </div>
</header>
