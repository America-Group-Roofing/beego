---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Página no encontrada" description="La dirección solicitada no corresponde a una página de BeeGo.">
  <section class="page-heading container">
    <p class="eyebrow">ERROR 404</p>
    <h1>No encontramos esa página.</h1>
    <p class="lead">La dirección que buscas no está disponible. Vuelve al inicio y continúa explorando BeeGo.</p>
    <a class="button button--dark" href="/">Volver a inicio</a>
  </section>
</BaseLayout>
