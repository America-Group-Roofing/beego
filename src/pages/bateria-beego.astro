---
import BaseLayout from "../layouts/BaseLayout.astro";
const views = [
{code:"PB01",name:"Vista protagonista",file:"beego-hero.webp",width:1050,height:1341,alt:"Power bank amarillo BeeGo en perspectiva con identidad de abeja negra y rayo central."},
{code:"PB02",name:"Vista frontal",file:"beego-producto-frontal.webp",width:740,height:1477,alt:"Vista frontal de batería BeeGo con tres luces y señal RETURN."},
{code:"PB05",name:"Lateral USB-C",file:"beego-producto-lateral-usbc.webp",width:204,height:1250,alt:"Vista lateral ilustrativa de batería BeeGo con puerto USB-C."},
{code:"PB04",name:"Lateral del botón",file:"beego-producto-lateral-boton.webp",width:380,height:760,alt:"Vista lateral amarilla de un dispositivo BeeGo con botón ovalado."},
{code:"PB06",name:"Contactos inferiores",file:"beego-producto-contactos.webp",width:1250,height:342,alt:"Vista ilustrativa de la parte inferior del equipo con seis contactos circulares y dos elementos centrales oscuros."}
];
---
<BaseLayout title="Conoce tu BeeGo" description="Explora las vistas del diseño de batería portátil BeeGo y conoce sus características visuales.">
  <section class="page-heading container"><p class="eyebrow">PRODUCT EXPERIENCE · BEEGO</p><h1>Conoce tu BeeGo</h1><p class="lead">La presentación visual de nuestra propuesta de batería portátil.</p><p class="notice">Las vistas son renders de diseño, no fotografías del producto fabricado ni validación técnica.</p></section>
  <section class="section section--soft">
    <div class="container">
      <h2>Explora el diseño</h2>
      <div class="product-gallery">
        {views.map((v,i)=><figure class:list={["product-gallery__item",{"product-gallery__item--hero":i===0}]}>
          <div class="product-gallery__canvas"><img src={"/assets/"+v.file} alt={v.alt} width={v.width} height={v.height} loading={i===0?"eager":"lazy"} decoding="async"/></div>
          <figcaption><span>{v.code}</span><strong>{v.name}</strong><small>Referencia visual pendiente de comparación con el hardware definitivo.</small></figcaption>
        </figure>)}
      </div>
    </div>
  </section>
  <section class="section"><div class="container split-section"><div><p class="eyebrow">TRANSPARENCIA TÉCNICA</p><h2>Diseño visible. Características por verificar.</h2></div><div><p>La carcasa amarilla, la abeja, el rayo, la señal RETURN y las conexiones representadas proceden del material visual del proyecto. No afirmamos potencia, certificaciones, autonomía ni compatibilidad universal sin pruebas.</p><a class="text-link" href="/como-funciona/">Conocer el recorrido previsto <span aria-hidden="true">↗</span></a></div></div></section>
</BaseLayout>
